



{
  "manifest_version": 3,
  "name": "NextZiel Job Saver",
  "version": "1.0.0",
  "description": "Save jobs directly to NextZiel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://jobpilot-api-whlc.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to NextZiel"
  }
}