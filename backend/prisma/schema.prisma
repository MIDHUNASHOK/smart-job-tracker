generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
model Job {

  id            String   @id @default(cuid())

  job_Title     String
  company_Name  String
  location      String

  job_Type      String
  work_mode     String

  status        String

  applied_Date  DateTime

  job_Url       String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}